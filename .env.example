# ---- Google Gemini API ----
# Chave da API do Google Gemini (usada SOMENTE no backend, nunca no frontend)
GEMINI_API_KEY=

# ---- Administrador ----
# E-mail do usuário que terá análises ilimitadas (verificado no backend)
ADMIN_EMAIL=

# ---- Limite diário de análises gratuitas ----
DAILY_FREE_ANALYSIS_LIMIT=3

# ---- Backend ----
# Origem(ns) permitida(s) para o CORS do FastAPI
FRONTEND_ORIGIN=http://localhost:5173
