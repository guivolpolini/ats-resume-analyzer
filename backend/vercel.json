{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|health|assets).*)",
      "destination": "/index.html"
    }
  ]
}
