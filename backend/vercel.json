{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|health|assets).*)",
      "destination": "/index.html"
    }
  ]
}
